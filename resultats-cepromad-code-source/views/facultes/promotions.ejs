<%- include('../partials/header') %>
<div class="page-header"><h1>Promotions</h1></div>

<div class="card">
  <h3>Ajouter une promotion</h3>
  <form method="POST" action="/admin/facultes/promotions" class="form-row">
    <div><label>Nom</label><input type="text" name="nom" placeholder="ex: L1 Informatique" required></div>
    <div>
      <label>Faculté</label>
      <select name="faculte_id" required>
        <option value="">—</option>
        <% facultes.forEach(f => { %><option value="<%= f.id %>"><%= f.nom %></option><% }) %>
      </select>
    </div>
    <div style="align-self:end;"><button type="submit" class="btn">Ajouter</button></div>
  </form>
  <% if (facultes.length === 0) { %><p style="color:var(--muted); font-size:0.85rem;">Créez d'abord une <a href="/admin/facultes">faculté</a>.</p><% } %>
</div>

<table>
  <thead><tr><th>Faculté</th><th>Promotion</th><th>Effectif</th><th></th></tr></thead>
  <tbody>
    <% promotions.forEach(p => { %>
      <tr>
        <td><%= p.faculte_nom %></td>
        <td><%= p.nom %></td>
        <td><%= p.effectif %></td>
        <td>
          <a href="/admin/cours?promotion_id=<%= p.id %>" class="btn btn-sm btn-secondary">Cours</a>
          <form class="inline" method="POST" action="/admin/facultes/promotions/<%= p.id %>?_method=DELETE" onsubmit="return confirm('Supprimer cette promotion ?');">
            <button class="btn btn-sm btn-danger" type="submit">Suppr.</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (promotions.length === 0) { %><tr><td colspan="4">Aucune promotion pour cette année.</td></tr><% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
