<%- include('../partials/header') %>
<div class="page-header"><h1>Tableau de bord</h1></div>

<div class="grid grid-4">
  <div class="stat-card"><div class="label">Étudiants inscrits</div><div class="value"><%= nbEtudiants %></div></div>
  <div class="stat-card"><div class="label">Facultés</div><div class="value"><%= nbFacultes %></div></div>
  <div class="stat-card"><div class="label">Promotions</div><div class="value"><%= nbPromotions %></div></div>
  <div class="stat-card"><div class="label">Résultats saisis</div><div class="value"><%= nbResultats %></div></div>
</div>

<div class="card" style="margin-top:20px;">
  <h3>Promotions et publication</h3>
  <table>
    <thead><tr><th>Faculté</th><th>Promotion</th><th>Effectif</th><th>Publication (session principale)</th></tr></thead>
    <tbody>
      <% promotions.forEach(p => { %>
        <tr>
          <td><%= p.faculte_nom %></td>
          <td><%= p.nom %></td>
          <td><%= p.effectif %></td>
          <td>
            <% if (p.publie) { %><span class="badge badge-success">Publiés</span>
            <% } else { %><span class="badge badge-muted">Non publiés</span><% } %>
          </td>
        </tr>
      <% }) %>
      <% if (promotions.length === 0) { %><tr><td colspan="4">Aucune promotion pour cette année.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
